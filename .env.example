MONGO_ROOT_USERNAME=mongo
MONGO_ROOT_PASSWORD=replace-with-a-long-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Public origin of the app, e.g. https://photos.example.com
CLIENT_URL=http://localhost:5173
# Host port for the client container. Keep it off 80/443 when using the https profile.
CLIENT_PORT=5173

# Domain for the optional Caddy HTTPS service (docker compose --profile https up -d --build)
DOMAIN=

# local | cloudinary | s3
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
